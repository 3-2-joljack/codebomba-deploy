# ===== 직접 채워야 하는 값 =====

# 접속 주소. 도메인이 없으면 http://서버공인IP, 있으면 https://도메인 (HTTPS 자동 발급)
PUBLIC_URL=

# [필수] Gemini API 키 (Google AI Studio). 챗봇, 추천, AI 브리핑 공용
GEMINI_API_KEY=

# [필수에 가까움] GCS. 키 파일은 secrets/gcp-storage-key.json 으로 저장
GCP_PROJECT_ID=
GCP_STORAGE_BUCKET=

# [권장] Gmail 발송 계정과 앱 비밀번호 (공백 없이). 회원가입 인증 메일용
MAIL_USERNAME=
MAIL_PASSWORD=

# [선택] 구글 로그인. HTTPS 도메인이 있을 때만 동작
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ===== 아래는 setup.sh 가 자동 생성 (건드릴 필요 없음) =====
