# ===== 직접 채워야 하는 값 =====

# 접속 주소. 도메인이 없으면 http://서버공인IP, 있으면 https://도메인 (HTTPS 자동 발급)
PUBLIC_URL=

# [필수] Gemini API 키 (Google AI Studio). 챗봇, 추천, AI 브리핑 공용
GEMINI_API_KEY=

# [선택] 이메일 인증. 기본은 꺼짐(false): 회원가입 인증번호와 새 기기 로그인 OTP 없이 동작한다.
# true 로 켜려면 아래 Gmail 발송 계정과 앱 비밀번호(공백 없이)도 채운다.
EMAIL_VERIFICATION_ENABLED=false
MAIL_USERNAME=
MAIL_PASSWORD=

# [선택] 구글 로그인. HTTPS 도메인이 있을 때만 동작
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ===== 아래는 setup.sh 가 자동 생성 (건드릴 필요 없음) =====
